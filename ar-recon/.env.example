# --- Application ---
APP_NAME="AR Reconciliation"
APP_ENV=development
LOG_LEVEL=INFO

# --- Database ---
DATABASE_URL=postgresql+psycopg2://ar_user:ar_pass@localhost:5432/ar_recon

# --- Reconciliation business rules (configurable, never hardcoded) ---
RECON_TOLERANCE=1.00                 # abs(net_sales - net_settlement) <= tolerance -> MATCHED
RT_RTO_STRATEGY=indicator_then_presence   # indicator_then_presence | presence_only | indicator_only
RT_RTO_INDICATOR_COLUMN=return_type       # optional explicit RT/RTO indicator, if present in data

# --- Ingestion ---
EXCEL_CHUNK_ROWS=50000               # streaming batch size for bulk insert
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=512

# --- CORS (frontend origins, comma-separated) ---
CORS_ORIGINS_RAW=http://localhost:5173,http://127.0.0.1:5173

# Parquet cache (decode .xlsb/.xlsx once, then columnar re-reads)
CACHE_DIR=./data/cache

# Opt-in: treat packet_id and order_release_id as the same value (no link file needed)
ASSUME_PACKET_EQUALS_ORDER=false
